<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ seo.titulo }}</title>
<meta name="description" content="{{ seo.descricao }}">
{% if previa %}<meta name="robots" content="noindex,nofollow">{% else %}<link rel="canonical" href="{{ url }}">{% endif %}
<meta name="theme-color" content="{{ cores.destaque }}">
<meta property="og:type" content="book">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content="{{ seo.titulo }}">
<meta property="og:description" content="{{ seo.descricao }}">
<meta property="og:url" content="{{ url }}">
<meta property="og:image" content="{{ url }}img/{{ og_imagem }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,700;0,9..40,800;1,9..40,400&family={{ fonte.google }}&display=swap">
<link rel="preload" as="image" href="img/{{ hero.imagem.arquivo }}-800.webp" imagesrcset="img/{{ hero.imagem.arquivo }}-800.webp 800w, img/{{ hero.imagem.arquivo }}-1400.webp 1400w" imagesizes="(max-width:860px) 100vw, 560px">
<script type="application/ld+json">{{ jsonld | safe }}</script>
<!--
  LP LIVRO ÚNICO · Global Assessoria · v3
  Gerado por build.py a partir de lp.json. Não edite este arquivo à mão:
  altere o lp.json e gere de novo.
-->
<style>
:root{
  --f-titulo:{{ fonte.css }};
  --peso-titulo:{{ fonte.peso }};
  --cor-claro:{{ cores.claro }};
  --cor-medio:{{ cores.medio }};
  --cor-escuro:{{ cores.escuro }};
  --cor-destaque:{{ cores.destaque }};
  --cor-botao:{{ cores.botao }};
  --cor-botao-texto:{{ cores.botao_texto }};
  --cor-texto:{{ cores.texto }};
  --cor-texto-claro:{{ cores.texto_claro }};
  --cor-rodape:{{ cores.rodape }};
  --cor-rodape-texto:{{ cores.rodape_texto }};

  --f-texto:"DM Sans", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  --largura:1120px;
  --gutter:clamp(20px, 5vw, 40px);
  --raio:18px;
  --secao:clamp(64px, 9vw, 120px);
  color-scheme:light;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;scroll-padding-top:84px}
body{margin:0;background:var(--cor-claro);color:var(--cor-texto);font-family:var(--f-texto);font-size:clamp(16px, 1.05vw + 12px, 18px);font-weight:400;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}
a{color:inherit}
p{margin:0;text-wrap:pretty}
strong{font-weight:800}
::selection{background:var(--cor-destaque);color:var(--cor-botao-texto)}
:focus-visible{outline:3px solid var(--cor-destaque);outline-offset:3px;border-radius:6px}
.lp-pular{position:absolute;left:12px;top:-60px;z-index:50;background:var(--cor-botao);color:var(--cor-botao-texto);padding:10px 16px;border-radius:999px;font-weight:700;text-decoration:none;transition:top .2s}
.lp-pular:focus{top:12px}

.lp-wrap{width:100%;max-width:var(--largura);margin-inline:auto;padding-inline:var(--gutter)}
.lp-secao{padding-block:var(--secao)}
.lp-escura{background:var(--cor-escuro);color:var(--cor-texto-claro)}
.lp-escura :focus-visible{outline-color:var(--cor-texto-claro)}
.lp-prosa{display:grid;gap:1.1em;max-width:66ch}

/* Tipografia */
.lp-marca{font-family:var(--f-titulo);font-weight:var(--peso-titulo);font-size:clamp(17px, 1.2vw + 11px, 23px);line-height:1.1;letter-spacing:.06em;text-transform:uppercase;text-decoration:none}
.lp-eyebrow{font-family:var(--f-texto);font-weight:800;font-size:12.5px;line-height:1.3;letter-spacing:.18em;text-transform:uppercase;color:var(--cor-destaque);margin:0}
.lp-h1{font-family:var(--f-titulo);font-weight:var(--peso-titulo);font-size:clamp(42px, 4.6vw + 8px, 74px);line-height:1.04;letter-spacing:-.01em;color:var(--cor-destaque);margin:0;text-wrap:balance}
.lp-h2{font-family:var(--f-titulo);font-weight:var(--peso-titulo);font-size:clamp(32px, 3.4vw + 10px, 52px);line-height:1.08;letter-spacing:-.01em;margin:0;text-wrap:balance}
.lp-tagline{font-family:var(--f-texto);font-weight:800;font-size:clamp(17px, .6vw + 13px, 19px);line-height:1.4}
.lp-tagline em{font-style:normal;color:var(--cor-destaque)}

/* Botão de compra */
.lp-btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;min-height:56px;padding:.9em 1.8em;border-radius:999px;background:var(--cor-botao);color:var(--cor-botao-texto);font-family:var(--f-texto);font-weight:800;font-size:15px;line-height:1.2;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;box-shadow:0 10px 24px -10px rgba(40,15,10,.55);transition:transform .2s ease,filter .2s ease,box-shadow .2s ease}
.lp-btn:hover{transform:translateY(-2px);filter:brightness(1.08);box-shadow:0 16px 30px -12px rgba(40,15,10,.6)}
.lp-btn svg{width:1.1em;height:1.1em;flex:none;transition:transform .2s ease}
.lp-btn:hover svg{transform:translateX(3px)}
.lp-lojas{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;font-size:13.5px;opacity:.85}
.lp-lojas a{font-weight:700;text-underline-offset:3px}
.lp-lojas a:hover{opacity:.75}

/* Instagram */
.lp-ig{display:inline-flex;align-items:center;gap:.55em;padding:5px 14px 5px 5px;border-radius:999px;background:#FFF8F0;color:#2A1F18;text-decoration:none;font-family:var(--f-texto);font-size:14px;font-weight:700;white-space:nowrap;transition:transform .2s ease}
.lp-ig:hover{transform:translateY(-1px)}
.lp-ig img{width:30px;height:30px;border-radius:50%;object-fit:cover}
.lp-ig:not(:has(img)){padding:8px 16px}
.lp-siga{display:flex;align-items:center;gap:.75em;font-size:13px}

/* Header */
.lp-topo{position:sticky;top:0;z-index:20;background:var(--cor-destaque);color:var(--cor-botao-texto);padding-top:env(safe-area-inset-top,0px);transition:box-shadow .3s ease}
.lp-topo.rolou{box-shadow:0 8px 24px -16px rgba(0,0,0,.6)}
.lp-topo .lp-wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px}
.lp-topo .lp-marca{min-width:0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
@media (max-width:560px){
  .lp-topo .lp-siga-label{display:none}
  .lp-topo .lp-ig:has(img) span{display:none}
  .lp-topo .lp-ig:has(img){padding:5px}
  .lp-topo .lp-ig:not(:has(img)){padding:6px 12px;font-size:12.5px}
  .lp-topo .lp-marca{font-size:15px}
}

/* Imagens */
.lp-foto{border-radius:var(--raio);overflow:hidden;background:rgba(0,0,0,.08);box-shadow:0 30px 60px -30px rgba(0,0,0,.45)}
.lp-foto img{width:100%;height:100%;object-fit:cover}

/* Hero */
.lp-hero{background:var(--cor-medio);padding-block:clamp(36px, 6vw, 88px)}
.lp-hero-grid{display:grid;grid-template-columns:1.05fr 1fr;grid-template-areas:"img head" "img corpo";column-gap:clamp(32px, 5vw, 72px);row-gap:20px;align-items:center}
.lp-hero-img{grid-area:img}
.lp-hero-img .lp-foto{aspect-ratio:1/1}
.lp-hero-head{grid-area:head;align-self:end;display:grid;gap:14px}
.lp-hero-corpo{grid-area:corpo;align-self:start;display:grid;gap:18px;justify-items:start}
.lp-ficha{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.lp-ficha li{font-size:12.5px;font-weight:700;letter-spacing:.04em;padding:5px 12px;border-radius:999px;border:1px solid color-mix(in srgb, var(--cor-texto) 22%, transparent)}
@media (max-width:860px){
  .lp-hero-grid{grid-template-columns:1fr;grid-template-areas:"head" "img" "corpo";row-gap:28px}
  .lp-hero-corpo{justify-items:stretch}
}

/* Sinopse */
.lp-sinopse .lp-wrap{display:grid;gap:clamp(28px, 4vw, 48px);justify-items:center;text-align:center}
.lp-sinopse .lp-h2{max-width:22ch;color:var(--cor-texto-claro)}
.lp-sinopse .lp-prosa{text-align:left}
.lp-sinopse .lp-prosa p:first-child{font-size:1.15em;line-height:1.55}

/* Diferenciais */
.lp-ksp-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px, 5vw, 72px);align-items:start}
.lp-ksp-texto{display:grid;gap:clamp(24px, 3vw, 36px);align-content:start;min-width:0}
.lp-ksp-texto .lp-h2{color:var(--cor-destaque)}
.lp-ksp-lista{list-style:none;margin:0;padding:0;display:grid}
.lp-ksp-lista li{display:grid;gap:6px;padding-block:22px;border-top:1px solid rgba(0,0,0,.15)}
.lp-ksp-lista li:last-child{border-bottom:1px solid rgba(0,0,0,.15)}
.lp-ksp-titulo{font-family:var(--f-texto);font-weight:800;font-size:clamp(17px, .6vw + 13px, 19px);line-height:1.35;color:var(--cor-destaque);margin:0;display:flex;gap:.6em;align-items:baseline}
.lp-ksp-titulo::before{content:"";flex:none;width:.55em;height:.55em;border-radius:50%;background:var(--cor-destaque);transform:translateY(-.08em)}
.lp-ksp-lista p{padding-left:1.15em}
.lp-ksp-img{position:sticky;top:96px}
.lp-ksp-img .lp-foto{aspect-ratio:4/5}
@media (max-width:860px){
  .lp-ksp-grid{grid-template-columns:1fr}
  .lp-ksp-img{position:static;order:-1}
  .lp-ksp-img .lp-foto{aspect-ratio:16/11}
}

/* Trecho do livro */
.lp-trecho{background:var(--cor-medio)}
.lp-trecho figure{margin:0 auto;max-width:860px;display:grid;gap:24px;justify-items:center;text-align:center}
.lp-trecho blockquote{margin:0;font-family:var(--f-titulo);font-weight:var(--peso-titulo);font-size:clamp(24px, 2.2vw + 12px, 36px);line-height:1.3;color:var(--cor-texto);text-wrap:balance}
.lp-trecho blockquote::before{content:"\201C";display:block;font-size:2.4em;line-height:.6;color:var(--cor-destaque);margin-bottom:.15em}
.lp-trecho figcaption{font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--cor-destaque)}

/* Depoimentos */
.lp-depo .lp-wrap{display:grid;gap:clamp(28px, 4vw, 48px)}
.lp-depo .lp-h2{color:var(--cor-destaque);text-align:center}
.lp-depo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.lp-depo-card{margin:0;background:color-mix(in srgb, var(--cor-medio) 45%, var(--cor-claro));border-radius:var(--raio);padding:28px;display:grid;gap:18px;align-content:space-between}
.lp-depo-card blockquote{margin:0}
.lp-depo-card figcaption{display:grid;gap:2px;font-size:14px}
.lp-depo-card figcaption b{font-weight:800}
.lp-depo-card figcaption span{opacity:.75}

/* Bio */
.lp-bio-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(36px, 5vw, 72px);align-items:center}
.lp-bio .lp-foto{aspect-ratio:4/5;max-width:440px}
.lp-bio-texto{display:grid;gap:20px;min-width:0;justify-items:start}
.lp-bio .lp-eyebrow{color:var(--cor-texto-claro);opacity:.75}
.lp-bio .lp-h2{color:var(--cor-texto-claro)}
@media (max-width:860px){ .lp-bio-grid{grid-template-columns:1fr} .lp-bio .lp-foto{max-width:none;aspect-ratio:1/1} }
.lp-bio-grid:not(:has(.lp-foto)){grid-template-columns:minmax(0,760px);justify-content:center}

/* Última chamada */
.lp-final{background:var(--cor-medio)}
.lp-final-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px, 5vw, 72px);align-items:center}
.lp-final-texto{display:grid;gap:20px;justify-items:start;min-width:0}
.lp-final .lp-h2{color:var(--cor-destaque)}
.lp-final .lp-foto{aspect-ratio:1/1}
.lp-fecho{font-weight:800}
@media (max-width:860px){
  .lp-final-grid{grid-template-columns:1fr}
  .lp-final-img{order:-1}
  .lp-final-texto{justify-items:stretch}
  .lp-btn{width:100%}
}

/* Rodapé + assinatura Global (fixos em todas as LPs) */
.lp-rodape{background:var(--cor-rodape);color:var(--cor-rodape-texto);padding-block:40px calc(40px + env(safe-area-inset-bottom,0px))}
.lp-rodape-grid{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:28px}
.lp-rodape .lp-siga{justify-self:center}
.lp-assinatura{justify-self:end;display:grid;justify-items:end;gap:8px;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-decoration:none}
.lp-assinatura img{height:36px;width:auto;{% if cores.rodape_texto_claro %}filter:brightness(0) invert(1){% else %}filter:brightness(0){% endif %}}
.lp-copy{grid-column:1/-1;border-top:1px solid color-mix(in srgb, currentColor 25%, transparent);padding-top:20px;font-size:12.5px;text-align:center}
@media (max-width:760px){
  .lp-rodape-grid{grid-template-columns:1fr;justify-items:center;text-align:center}
  .lp-assinatura,.lp-rodape .lp-siga{justify-self:center;justify-items:center}
}

/* Barra fixa de compra (celular) */
.lp-barra{position:fixed;left:0;right:0;bottom:0;z-index:30;display:none;background:var(--cor-claro);border-top:1px solid rgba(0,0,0,.12);padding:10px var(--gutter) calc(10px + env(safe-area-inset-bottom,0px));transform:translateY(110%);transition:transform .35s ease}
.lp-barra .lp-btn{min-height:50px;width:100%}
.lp-barra.on{transform:none}
@media (max-width:860px){ .lp-barra{display:block} }

/* Entrada suave ao rolar */
.js .rev{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
.js .rev.vis{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{transition:none!important;scroll-behavior:auto!important}
  .js .rev{opacity:1;transform:none}
}
</style>
<script>document.documentElement.classList.add("js")</script>
</head>
<body>
{% macro seta() %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{% endmacro %}
{% macro img(i, sizes, lazy=true) %}<picture><source type="image/webp" srcset="img/{{ i.arquivo }}-800.webp 800w, img/{{ i.arquivo }}-1400.webp 1400w" sizes="{{ sizes }}"><img src="img/{{ i.arquivo }}-1400.jpg" width="{{ i.w }}" height="{{ i.h }}" alt="{{ i.alt }}" {% if lazy %}loading="lazy" decoding="async"{% else %}fetchpriority="high"{% endif %}></picture>{% endmacro %}
{% macro ig(classe='') %}{% if instagram %}<a class="lp-ig" href="{{ instagram.url }}" target="_blank" rel="noopener" data-cta="instagram">{% if instagram.foto %}<img src="img/{{ instagram.foto }}" alt="" width="30" height="30" loading="lazy">{% endif %}<span>@{{ instagram.usuario }}</span></a>{% endif %}{% endmacro %}
{% macro comprar(local) %}<a class="lp-btn" href="{{ compra.principal.url }}" target="_blank" rel="noopener" data-cta="{{ local }}"{% if local == 'hero' %} id="cta-hero"{% endif %}>{{ compra.texto_botao }} {{ seta() }}</a>{% endmacro %}
{% macro lojas() %}{% if compra.outros %}<p class="lp-lojas"><span>Também em</span>{% for l in compra.outros %}<a href="{{ l.url }}" target="_blank" rel="noopener" data-cta="loja-{{ loop.index }}">{{ l.rotulo }}</a>{% endfor %}</p>{% endif %}{% endmacro %}

<a class="lp-pular" href="#conteudo">Pular para o conteúdo</a>

<header class="lp-topo" id="topo">
  <div class="lp-wrap">
    <a class="lp-marca" href="#inicio">{{ livro.titulo }}</a>
    {% if instagram %}<div class="lp-siga"><span class="lp-siga-label">{{ instagram.rotulo }}</span>{{ ig() }}</div>{% endif %}
  </div>
</header>

<main id="inicio">

  <section class="lp-hero" id="conteudo">
    <div class="lp-wrap lp-hero-grid">
      <div class="lp-hero-img"><div class="lp-foto">{{ img(hero.imagem, "(max-width:860px) 100vw, 560px", false) }}</div></div>
      <div class="lp-hero-head">
        <p class="lp-eyebrow">{{ livro.autor }}</p>
        <h1 class="lp-h1">{{ livro.titulo }}</h1>
      </div>
      <div class="lp-hero-corpo">
        <p class="lp-tagline">{{ hero.tagline }}</p>
        <p>{{ hero.descricao }}</p>
        {% if ficha %}<ul class="lp-ficha" aria-label="Ficha do livro">{% for f in ficha %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
        {{ comprar('hero') }}
        {{ lojas() }}
      </div>
    </div>
  </section>

  <section class="lp-secao lp-escura lp-sinopse" aria-labelledby="t-sinopse">
    <div class="lp-wrap">
      <h2 class="lp-h2 rev" id="t-sinopse">{{ sinopse.titulo }}</h2>
      <div class="lp-prosa rev">{% for p in sinopse.paragrafos %}<p>{{ p }}</p>{% endfor %}</div>
    </div>
  </section>

  <section class="lp-secao lp-ksp" aria-labelledby="t-dif">
    <div class="lp-wrap lp-ksp-grid">
      <div class="lp-ksp-texto">
        <h2 class="lp-h2 rev" id="t-dif">{{ diferenciais.titulo }}</h2>
        <ul class="lp-ksp-lista">{% for d in diferenciais.itens %}
          <li class="rev"><h3 class="lp-ksp-titulo">{{ d.titulo }}</h3><p>{{ d.texto }}</p></li>{% endfor %}
        </ul>
        <div>{{ comprar('diferenciais') }}</div>
      </div>
      <div class="lp-ksp-img"><div class="lp-foto">{{ img(diferenciais.imagem, "(max-width:860px) 100vw, 520px") }}</div></div>
    </div>
  </section>

  {% if trecho %}
  <section class="lp-secao lp-trecho" aria-label="Trecho do livro">
    <div class="lp-wrap">
      <figure class="rev"><blockquote>{{ trecho.texto }}</blockquote><figcaption>{{ trecho.referencia }}</figcaption></figure>
    </div>
  </section>
  {% endif %}

  {% if depoimentos %}
  <section class="lp-secao lp-depo" aria-labelledby="t-depo">
    <div class="lp-wrap">
      <h2 class="lp-h2 rev" id="t-depo">{{ depoimentos.titulo }}</h2>
      <div class="lp-depo-grid">{% for d in depoimentos.itens %}
        <figure class="lp-depo-card rev"><blockquote><p>{{ d.texto }}</p></blockquote><figcaption><b>{{ d.nome }}</b>{% if d.papel %}<span>{{ d.papel }}</span>{% endif %}</figcaption></figure>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="lp-secao lp-escura lp-bio" aria-labelledby="t-bio">
    <div class="lp-wrap lp-bio-grid">
      {% if bio.foto %}<div class="lp-foto rev">{{ img(bio.foto, "(max-width:860px) 100vw, 440px") }}</div>{% endif %}
      <div class="lp-bio-texto rev">
        <p class="lp-eyebrow">{{ bio.rotulo }}</p>
        <h2 class="lp-h2" id="t-bio">{{ bio.nome }}</h2>
        <div class="lp-prosa">{% for p in bio.paragrafos %}<p>{{ p }}</p>{% endfor %}</div>
        {{ ig() }}
      </div>
    </div>
  </section>

  <section class="lp-secao lp-final" id="cta-final" aria-labelledby="t-final">
    <div class="lp-wrap lp-final-grid">
      <div class="lp-final-texto rev">
        <h2 class="lp-h2" id="t-final">{{ final.titulo }}</h2>
        <p>{{ final.texto }}</p>
        {% if final.fecho %}<p class="lp-fecho">{{ final.fecho }}</p>{% endif %}
        {{ comprar('final') }}
        {{ lojas() }}
      </div>
      <div class="lp-final-img rev"><div class="lp-foto">{{ img(final.imagem, "(max-width:860px) 100vw, 520px") }}</div></div>
    </div>
  </section>
</main>

<footer class="lp-rodape">
  <div class="lp-wrap lp-rodape-grid">
    <a class="lp-marca" href="#inicio">{{ livro.titulo }}</a>
    {% if instagram %}<div class="lp-siga"><span>{{ instagram.rotulo }}</span>{{ ig() }}</div>{% else %}<span></span>{% endif %}
    <a class="lp-assinatura" href="https://assessoriaglobal.com.br/" target="_blank" rel="noopener"><span>Desenvolvido por</span><img src="img/logo-global.png" alt="Global Assessoria" width="133" height="36"></a>
    <p class="lp-copy">© {{ ano }} {{ livro.autor }}. Todos os direitos reservados.</p>
  </div>
</footer>

<div class="lp-barra" id="lp-barra" aria-hidden="true">
  <a class="lp-btn" href="{{ compra.principal.url }}" target="_blank" rel="noopener" tabindex="-1" data-cta="barra">{{ compra.texto_botao }}</a>
</div>

<script>
(function(){
  var topo=document.getElementById("topo");
  addEventListener("scroll",function(){topo.classList.toggle("rolou",scrollY>8)},{passive:true});
  if(!("IntersectionObserver" in window)){document.querySelectorAll(".rev").forEach(function(e){e.classList.add("vis")});return}
  var rev=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("vis");rev.unobserve(e.target)}})},{rootMargin:"0px 0px -8% 0px"});
  document.querySelectorAll(".rev").forEach(function(e){rev.observe(e)});
  var barra=document.getElementById("lp-barra"),hero=document.getElementById("cta-hero"),fim=document.getElementById("cta-final");
  if(!barra||!hero||!fim)return;
  var heroVis=true,fimVis=false;
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.target===hero)heroVis=e.isIntersecting||e.boundingClientRect.top>0;else fimVis=e.isIntersecting});
    var on=!heroVis&&!fimVis;
    barra.classList.toggle("on",on);barra.setAttribute("aria-hidden",on?"false":"true");barra.querySelector("a").tabIndex=on?0:-1;
  });
  io.observe(hero);io.observe(fim);
})();
</script>
</body>
</html>
